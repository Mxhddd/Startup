    "t_a1": {"x": 0, "y": -300, "text": "A1 · Three directions: Saaf (picked) · Ghar · Sadak", "kind": "title1", "maxW": 2720, "page": "a1"},
    "n_saaf": {"x": 0, "y": 900, "text": "SAAF (clear) — picked. White ground, black ink, one solid colour + icon per step, Noto Nastaliq Urdu. Built for a cheap screen in noon sun.", "w": 800, "size": "l", "fill": "green", "page": "a1"},
    "n_ghar": {"x": 960, "y": 900, "text": "GHAR (home) — cream, deep teal, soft cards, Gulzar Nastaliq. Calmest and most familial, but tinted pills lose contrast outdoors.", "w": 800, "size": "l", "fill": "orange", "page": "a1"},
    "n_sadak": {"x": 1920, "y": 900, "text": "SADAK (road) — road-sign black and yellow, Naskh bold. Unmissable in sun, but reads urgent, not calm.", "w": 800, "size": "l", "fill": "gray", "page": "a1"},
    "n_edges": {"x": 880, "y": 900, "text": "1 child: same screen, no special case. 18 children: picked children fold into one row and absent ones shrink to chips, so the next child is still on the first screen (above 780 px). The list scrolls; the next TapButton is always scrolled into view after each tap.", "w": 560, "size": "m", "fill": "blue", "page": "driver"},
