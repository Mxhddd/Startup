# Names only. Copy to .env and fill in; .env is never committed.

# --- Public: allowed in the app and website bundles ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Crash reports (Sentry, free plan): the project's DSN. Public by design; leave empty to switch reports off.
EXPO_PUBLIC_SENTRY_DSN=
# v21: Google sign-in (the Web client ID from Google Cloud; public, not a secret)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public; the secret goes only in Supabase as TURNSTILE_SECRET)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SITE_URL=

# --- Website app links (not secret; Vercel settings) ---
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=

# --- Server only: Supabase Edge Function secrets, Vercel server env, CI secrets ---
SUPABASE_SERVICE_ROLE_KEY=
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
SEND_SMS_HOOK_SECRET=
EXPO_ACCESS_TOKEN=
ADMIN_PHONES=
EAS_TOKEN=

# iPhone Live Activity updates on locked phones (Edge Function secrets, server only; v7).
# From the Apple Developer account: Keys > + > Apple Push Notifications service (APNs), download the .p8.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_HOST=
# Sentry: only for uploading source maps from a build machine; never in an app or the website.
SENTRY_AUTH_TOKEN=
