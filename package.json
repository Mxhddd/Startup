{
  "name": "pohnch",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build:web": "pnpm --filter @pohnch/web build",
    "test:web": "pnpm --filter @pohnch/web test:e2e",
    "check": "pnpm typecheck && pnpm test && pnpm build:web",
    "test:db": "node supabase/tests/run.mjs",
    "bundle:apps": "pnpm --filter @pohnch/parent bundle:check && pnpm --filter @pohnch/driver bundle:check",
    "check:leaks": "node scripts/check-leaks.mjs apps/web/.next/static apps/web/.next/server/app apps/parent/dist apps/driver/dist"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
